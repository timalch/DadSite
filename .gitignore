# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# --- Next.js build output ---
.next/
out/
build/
dist/
next-env.d.ts

# --- Vercel ---
.vercel/

# --- Testing / coverage ---
coverage/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Facebook "Download Your Information" export (raw, unprocessed) ---
# Keep the raw personal archive out of git; only generated markdown/images get committed.
/fb-export/
/facebook-export/
*.zip

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# --- TypeScript ---
*.tsbuildinfo
