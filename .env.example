# Copy to `.env.local` for local development. NEVER commit `.env.local`.
# In production these are set in the Vercel dashboard under
# Project → Settings → Environment Variables — never in this repo.

# Absolute public URL of the site. Used for Open Graph tags, canonical URLs
# and the RSS feed. Vercel sets this automatically in production; you only
# need it locally or when using a custom domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional, phase 5 (content pipelines) -------------------------------
# Only needed if the Facebook oEmbed auto-fetch path is pursued. See the
# handoff doc §5a and the caveats raised during phase 1 planning.
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
